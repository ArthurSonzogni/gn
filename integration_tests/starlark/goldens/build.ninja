ninja_required_version = 1.7.2


# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.

build build.ninja: phony build.ninja.stamp
  generator = 1

rule action_ACTION
  command = $command
  restat = 1
  description = ACTION $out

rule action_TOOL
  command = $command
  restat = 1
  description = TOOL $out

subninja toolchain.ninja

build actions: phony obj/actions/actions.a
build custom_shared: phony ./libcustom_shared.so
build filegroup: phony ../first.txt
build filegroups: phony phony/$:filegroups_0
build multiple: phony phony/$:multiple_0
build $:actions: phony obj/actions/actions.a
build $:custom_shared: phony ./libcustom_shared.so
build $:filegroup: phony ../first.txt
build $:filegroups: phony phony/$:filegroups_0
build $:multiple: phony phony/$:multiple_0

build all: phony $
    obj/actions/actions.a $
    ./libcustom_shared.so $
    ../first.txt $
    phony/$:filegroups_0 $
    phony/$:multiple_0

default all
