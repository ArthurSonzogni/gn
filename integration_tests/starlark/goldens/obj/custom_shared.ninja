defines =
include_dirs =
cflags =
target_out_dir = obj
target_output_name = libcustom_shared
starlark_cflags = -DFOO=bar
starlark_ldflags = -Wl,-rpath=foo

build obj/libcustom_shared.shared.o: cxx ../shared.cc | ../first.txt
  source_file_part = shared.cc
  source_name_part = shared

build ./libcustom_shared.so: solink obj/libcustom_shared.shared.o | ../second.txt
  ldflags =
  libs =
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
