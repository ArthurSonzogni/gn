load(":filegroup.scl", "filegroup", "filegroups")
load(":inputs.scl", "custom_shared_library")

filegroup("filegroup") {
  srcs = [ "first.txt" ]
}

filegroup("multiple") {
  srcs = [
    "second.txt",
    "third.txt",
  ]
}

filegroups("filegroups") {
  filegroups = [
    ":filegroup",
    ":multiple",
  ]
}

custom_shared_library("custom_shared") {
  sources = [ "shared.cc" ]
  compile_input = "first.txt"
  link_input = "second.txt"
}
